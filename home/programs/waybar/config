{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 6,
  "fixed-center": true,
  "modules-left": ["image#power-menu", "tray"],
  "modules-center": ["sway/workspaces"],
  "modules-right": [
    "network",
    "pulseaudio",
    "pulseaudio#microphone",
    "backlight",
    "battery",
    "custom/notifications",
    "clock"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "sort-by-number": true,
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "甲",
      "11": "乙"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    },
    "format": "{icon}"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Sin conexion"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [ "󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖" ],
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": [ "󰕿", "󰖀", "󰕾" ],
    "format-muted": "󰖁",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip": false
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "true",
    "on-scroll-down": "true",
    "tooltip": false
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 100%",
    "format-warning": "󰁼 {capacity}%",
    "format-critical": "󰂎 {capacity}%",
    "format-time": "{H}h {m}m",
    "tooltip-format": "{time}",
    "format-icons": [ "󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹" ]
  },
  "clock": {
    "format": "󰥔 {:%I:%M %p}",
    "tooltip": false,
    "on-click": "sh ~/.config/eww/scripts/calendar/toggle.sh"
  },
  "tray": {
    "icon-size": 14,
    "show-passive-items": true,
    "spacing": 8
  },
  "custom/notifications": {
    "format": "󰍡",
    "tooltip": false
  },
  "image#power-menu": {
    "path": "/home/giks/.config/waybar/icons/nixos.svg",
    "size": 18,
    "on-click": "sh ~/.config/eww/scripts/power-menu/toggle.sh",
    "tooltip": false
  }
}
